# Your live domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where booking requests and contact messages are POSTed as JSON
INQUIRY_WEBHOOK_URL=

# Set to false at launch to hide the dashed placeholder notes
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# Secret iCal address of your bookings calendar (Google or iCloud).
# Any event on it blocks that date in the booking form.
BOOKING_CALENDAR_ICS_URL=
